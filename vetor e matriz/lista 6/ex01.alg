algoritmo "Primeiro Programa"

var
  vet: vetor[1..10] de inteiro
  i: inteiro

inicio

  vet[1] <- 2 vet[2] <- 3 vet[3] <- 4 vet[4] <- 5 vet[5] <- 6 vet[6] <- 7 vet[7] <- 8 vet[8] <- 9 vet[9] <- 10 vet[10] <- 11

  para i de 1 ate 10 passo 1 faca

    escreval(vet[i])

  fimpara

  i <- i + 1


fimalgoritmo
